#include <input/processors.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define MAC      0
#define WIN      1
#define NUM      2
#define FUNC     3

/ {
    behaviors {
        // tap: Cmd+Shift+4 (範囲スクショ) / hold: Cmd+Shift+5 (スクショメニュー)
        ss_ht: ss_ht {
            compatible = "zmk,behavior-hold-tap";
            label = "SS_HT";
            bindings = <&kp>, <&kp>;
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "balanced";
        };

        // Windows用: hold=LCTRL, tap=無変換(IME英数切替)
        ctrl_muhen: ctrl_muhen {
            compatible = "zmk,behavior-hold-tap";
            label = "CTRL_MUHEN";
            bindings = <&kp>, <&kp>;
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "balanced";
        };
    };

    macros {
        // BT0プロファイルに切替 + Macレイヤー固定
        bt_mac: bt_mac {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 0 &to MAC>;
            label = "BT_MAC";
        };

        // BT1プロファイルに切替 + Winレイヤー固定
        bt_win: bt_win {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 1 &to WIN>;
            label = "BT_WIN";
        };
    };

    combos {
        compatible = "zmk,combos";

        // ESC: Q + W
        combo_esc {
            timeout-ms = <50>;
            key-positions = <0 1>;
            bindings = <&kp ESC>;
        };

        // TAB: A + S
        combo_tab {
            timeout-ms = <50>;
            key-positions = <10 11>;
            bindings = <&kp TAB>;
        };

        // 英数: D + F
        combo_eisu {
            timeout-ms = <50>;
            key-positions = <12 13>;
            bindings = <&kp LANG2>;
        };

        // 左クリック: J + K
        combo_lclick {
            timeout-ms = <50>;
            key-positions = <16 17>;
            bindings = <&mkp MB1>;
        };

        // 右クリック: K + L
        combo_rclick {
            timeout-ms = <50>;
            key-positions = <17 18>;
            bindings = <&mkp MB2>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // Layer 0: Mac (Cmd tap=Ctrl+Space で macOS入力ソーストグル)
        mac_layer {
            bindings = <
&kp Q     &kp W     &kp E      &kp R          &kp T               &kp Y     &kp U           &kp I      &kp O    &kp P
&kp A     &kp S     &kp D      &kp F          &kp G               &kp H     &kp J           &kp K      &kp L    &kp SEMI
&kp Z     &kp X     &kp C      &kp V          &kp B               &kp N     &kp M           &kp COMMA  &kp DOT  &kp APOS
&kp LALT  &kp TAB   &kp LCTRL  &lt NUM SPACE  &mt LCMD LC(SPACE)  &kp BSPC  &lt FUNC ENTER  &kp RSHFT  &none    &ss_ht LG(LS(N5)) LG(LS(N4))
            >;
        };

        // Layer 1: Windows
        win_layer {
            bindings = <
&kp Q     &kp W     &kp E      &kp R          &kp T                           &kp Y     &kp U           &kp I      &kp O    &kp P
&kp A     &kp S     &kp D      &kp F          &kp G                           &kp H     &kp J           &kp K      &kp L    &kp SEMI
&kp Z     &kp X     &kp C      &kp V          &kp B                           &kp N     &kp M           &kp COMMA  &kp DOT  &kp APOS
&kp LGUI  &kp TAB   &kp LCTRL  &lt NUM SPACE  &ctrl_muhen LCTRL INT_MUHENKAN  &kp BSPC  &lt FUNC ENTER  &kp RSHFT  &none    &kp LG(LS(S))
            >;
        };

        // Layer 2: NUM (記号もここに集約)
        num_layer {
            label = "NUMBER";
            bindings = <
&kp MINUS  &kp N1  &kp N2  &kp N3  &kp PLUS   &kp CARET  &kp AMPS  &kp TILDE  &kp LPAR  &kp RPAR
&kp SLASH  &kp N4  &kp N5  &kp N6  &kp N0     &kp EXCL   &kp AT    &kp HASH   &kp DLLR  &kp PRCNT
&kp ASTRK  &kp N7  &kp N8  &kp N9  &kp DOT    &kp LBKT   &kp RBKT  &kp LBRC   &kp RBRC  &kp BSLH
&trans     &trans  &trans  &trans  &trans     &trans     &trans    &trans     &trans    &trans
            >;
        };

        // Layer 3: FUNCTION (旧ジェスチャー機能をボタン化)
        // 左 home row: タイル管理 (Ctrl+Alt+矢印)
        // 左 bottom row: アプリ切替 (Cmd+Tab系)
        // 右 home row: デスクトップ移動 (Ctrl+矢印 / Mission Control)
        // 右 bottom row: タブ操作 (Ctrl+Tab / Cmd+T / Cmd+W)
        func_layer {
            label = "FUNCTION";
            bindings = <
&bt_mac           &bt_win              &bt BT_SEL 2     &bt BT_SEL 3      &bt BT_SEL 4    &kp F1            &kp F2          &kp F3   &kp F4   &kp F5
&kp LC(LA(LEFT))  &kp LC(LA(DOWN))     &kp LC(LA(UP))   &kp LC(LA(RIGHT)) &bt BT_CLR      &kp LC(LEFT)      &trans          &kp LC(UP) &kp LC(RIGHT) &trans
&trans            &kp LG(LS(TAB))      &kp LG(TAB)      &kp LG(GRAVE)     &bt BT_CLR_ALL  &kp LC(LS(TAB))   &kp LC(TAB)     &kp LG(T) &kp LG(W) &trans
&trans            &trans               &trans           &trans            &trans          &trans            &trans          &trans     &trans   &trans
            >;
        };
    };
};
